# Nintendo data never enters version control
*.gb
*.gbc
*.sgb
*.sav
*.srm
*.state

# Extracted/derived game assets (regenerated from the user's ROM)
/generated/
**/public/rom-cache/

node_modules/
dist/
.vite/
*.log
.DS_Store
.env*
.wrangler/
.dev.vars*
!.dev.vars.example
*.tsbuildinfo

# Dev page renders (POST /__dev/shot)
shots/
# Screenshot regression baselines: renders of the ROM's graphics, per machine
apps/web/e2e/baselines/
test-results/
playwright-report/

# Blender save backups
*.blend1

# QA runs: screenshots, recordings and saves of the game
apps/qa/runs*/
# UI pass and fuzz screenshots (renders of ROM graphics), outside test-results so Playwright keeps them
apps/web/ui-runs/
