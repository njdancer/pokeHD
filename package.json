{
  "name": "pokehd",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @pokehd/web dev",
    "build": "pnpm --filter @pokehd/web build",
    "deploy": "pnpm --filter @pokehd/web run deploy",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "test": "vitest run",
    "rom:fetch": "tools/fetch-dev-rom.sh",
    "invite": "tools/invite.sh",
    "errors": "node tools/errors.ts",
    "perf": "node tools/perf.ts",
    "rom:build-disasm": "git submodule update --init vendor/pokered && make -C vendor/pokered -j8 blue",
    "rom:symbols": "pnpm rom:build-disasm && node tools/gen-symbols.ts && node tools/gen-explorer.ts",
    "test:e2e": "pnpm --filter @pokehd/web test:e2e"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
