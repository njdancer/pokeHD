{
  "name": "pokehd",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @pokehd/web dev",
    "build": "pnpm --filter @pokehd/web build",
    "deploy": "pnpm --filter @pokehd/web run deploy",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
