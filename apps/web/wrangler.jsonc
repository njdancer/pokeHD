{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokehd",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Private bucket holding Nick's test ROM, served only to requests carrying DEV_ROM_TOKEN
  // (a Worker secret). The single deliberate exception to "no Nintendo data on servers".
  "r2_buckets": [{ "binding": "PRIVATE", "bucket_name": "pokehd-private" }],
  "vars": { "DEV_ROM_KEY": "rom-a122f2e20e25a654c17a615c.gb" },
  "observability": { "enabled": true },
  "upload_source_maps": true
  // Durable Objects (multiplayer rooms) are added in the multiplayer phase.
}
