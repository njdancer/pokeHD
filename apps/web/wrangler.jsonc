{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokehd",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Private bucket holding Nick's cartridge, served only to Nick and the friends he shares it
  // with (D26), or to DEV_ROM_TOKEN (a Worker secret) for tools. The single deliberate exception
  // to "no Nintendo data on servers".
  // SAVES: players' battery-save backups (p1-saves-cloud), keyed by player ID and ROM SHA-1.
  "r2_buckets": [
    { "binding": "PRIVATE", "bucket_name": "pokehd-private" },
    { "binding": "SAVES", "bucket_name": "pokehd-saves" }
  ],
  // ADMIN_EMAIL is Nick (D23): the one admin, set here rather than in the database. Everyone
  // else is added from the game. EMAIL_FROM sends sign-in codes; its domain must be onboarded
  // in Email Service (Email Sending).
  "vars": {
    "DEV_ROM_KEY": "rom-a122f2e20e25a654c17a615c.gb",
    "ADMIN_EMAIL": "nick@dncr.me",
    "ADMIN_NAME": "Nick",
    "EMAIL_FROM": "pokehd@hearth.dncr.me"
  },
  // Cloudflare Email Service. Local dev simulates it and logs each email instead of sending.
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Multiplayer (D23): DIRECTORY holds players, sign-in codes and sessions; ROOM is the shared
  // world. Secret: ADMIN_TOKEN, for scripts and tests to add players (`pnpm invite`).
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "Room"] }]
}
